{
  "name": "starwest-ecommerce-api",
  "version": "1.0.0",
  "description": "REST API for e-commerce with JWT authentication and checkout functionality",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "mocha test/**/*.test.js --timeout 10000 --reporter spec",
    "test:discount": "mocha test/checkout-discount-equivalence-partitioning.test.js --timeout 10000 --reporter spec",
    "test:ci": "mocha test/**/*.test.js --timeout 15000 --reporter json > test-results.json"
  },
  "keywords": ["express", "jwt", "ecommerce", "api", "swagger"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "chai-http": "^4.3.0"
  }
}
